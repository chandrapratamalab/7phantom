# =============================================================================
# 7phantom — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
#
# RULES
#  1. `NEXT_PUBLIC_*` is inlined into the browser bundle. NEVER put a secret here.
#  2. Public values are read via `src/lib/env/client.ts`; everything else is
#     server-only and MUST be read via `src/lib/env/server.ts`.
#  3. `.env*.local` is gitignored. Never commit real keys.
#
# Supabase Dashboard -> Project Settings -> API Keys
#
# Running the LOCAL stack instead? (`npm run supabase:start`) use:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key from `npm run supabase:status`>
#   SUPABASE_SECRET_KEY=<service_role key from `npm run supabase:status`>
#   SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# =============================================================================

# -----------------------------------------------------------------------------
# Public (safe to expose — they end up in the client bundle)
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable API key, e.g. sb_publishable_xxx (replaces the legacy anon key).
# Safe in the browser: Row Level Security is what actually protects your data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical site URL — used for absolute redirect URLs and email templates.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Private — SERVER ONLY. `src/lib/env/server.ts` throws if these leak to the client.
# -----------------------------------------------------------------------------

# Secret API key, e.g. sb_secret_xxx (replaces the legacy service_role key).
# BYPASSES Row Level Security. Never import the admin client into a client
# component / Client Component / edge middleware.
SUPABASE_SECRET_KEY=

# JWKS endpoint used to verify Supabase user JWTs locally (no network round-trip
# per request). Found at:
#   {NEXT_PUBLIC_SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Optional: named secret keys as JSON, used by @supabase/server (`secret:name`).
# SUPABASE_SECRET_KEYS={"default":"sb_secret_xxx","cron":"sb_secret_yyy"}

# Optional: named publishable keys as JSON.
# SUPABASE_PUBLISHABLE_KEYS={"default":"sb_publishable_xxx","web":"sb_publishable_yyy"}

# Optional: direct Postgres connection string (Supabase CLI / migrations / RLS-scoped
# raw SQL via `withPostgresClient` from @supabase/server).
#
# Local stack (port matches [db].port in supabase/config.toml):
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54325/postgres
# Hosted project:
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
